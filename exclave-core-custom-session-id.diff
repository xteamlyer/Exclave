 transport/internet/splithttp/config.go    | 30 +++++++++++++++++++++++
 transport/internet/splithttp/config.pb.go | 29 ++++++++++++++++++++--
 transport/internet/splithttp/config.proto |  2 ++
 transport/internet/splithttp/dialer.go    |  4 +--
 5 files changed, 71 insertions(+), 5 deletions(-)

diff --git a/infra/conf/v4/transport_internet.go b/infra/conf/v4/transport_internet.go
index 551e589..d241fbf 100644
--- a/infra/conf/v4/transport_internet.go
+++ b/infra/conf/v4/transport_internet.go
@@ -424,6 +424,8 @@ type SplitHTTPConfig struct {
 	ScMaxEachPostBytes   string               `json:"scMaxEachPostBytes"`
 	ScMinPostsIntervalMs string               `json:"scMinPostsIntervalMs"`
 	ScMaxBufferedPosts   int64                `json:"scMaxConcurrentPosts"`
+	SessionIDTable       string               `json:"sessionIDTable"`
+	SessionIDLength      string               `json:"sessionIDLength"`
 	Xmux                 *XmuxConfig          `json:"xmux"`
 	DownloadSettings     *XHTTPDownloadConfig `json:"downloadSettings"`
 	UseBrowserForwarding bool                 `json:"useBrowserForwarding"`
@@ -564,8 +566,17 @@ func (c *SplitHTTPConfig) Build() (proto.Message, error) {
 		ScMaxEachPostBytes:   c.ScMaxEachPostBytes,
 		ScMinPostsIntervalMs: c.ScMinPostsIntervalMs,
 		ScMaxBufferedPosts:   c.ScMaxBufferedPosts,
+		SessionIDTable:       c.SessionIDTable,
+		SessionIDLength:      c.SessionIDLength,
 		UseBrowserForwarding: c.UseBrowserForwarding,
 	}
+	if c.SessionIDTable != "" {
+		for i := 0; i < len(c.SessionIDTable); i++ {
+			if c.SessionIDTable[i] >= 0x80 {
+				return nil, newError("sessionIDTable must contain only ASCII characters")
+			}
+		}
+	}
 	if config.XPaddingKey == "" {
 		config.XPaddingKey = "x_padding"
 	}
