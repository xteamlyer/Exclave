 	"net/http"
 	"strconv"
 	"strings"
 
 	"github.com/exclavenetwork/exclave-core/v5/common/buf"
 	"github.com/exclavenetwork/exclave-core/v5/common/serial"
+	"github.com/exclavenetwork/exclave-core/v5/common/uuid"
 	"github.com/exclavenetwork/exclave-core/v5/transport/internet"
 )
 
@@ -450,6 +452,34 @@ func (c *Config) ExtractMetaFromRequest(req *http.Request, path string) (session
 	return sessionId, seqStr
 }
 
+var (
+	sessionIDBase62Table   = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+	sessionIDHexTable      = "0123456789abcdef"
+	sessionIDHexUpperTable = "0123456789ABCDEF"
+)
+
+func (c *Config) GenerateSessionID() string {
+	length := newRandRangeConfig(0, 0, c.SessionIDLength).rand()
+	table := c.SessionIDTable
+	switch table {
+	case "base62":
+		table = sessionIDBase62Table
+	case "hex":
+		table = sessionIDHexTable
+	case "HEX":
+		table = sessionIDHexUpperTable
+	}
+	if table != "" && length > 0 {
+		id := make([]byte, length)
+		for i := range id {
+			id[i] = table[mrand.IntN(len(table))]
+		}
+		return string(id)
+	}
+	u := uuid.New()
+	return u.String()
+}
+
 func appendToPath(path, value string) string {
 	if strings.HasSuffix(path, "/") {
 		return path + value
